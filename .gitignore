__pycache__/
*.pyc
.venv/
.vscode/
.DS_Store

# silver intermedi, mai versionati
data/silver/
data/silver_trains/

# eventuali database locali
*.duckdb

# Le partizioni mensili parquet in data/gold/parts/ SONO lo store gold
# versionato: piccole, e ogni run notturno ne tocca una sola. Prima il gold
# viveva come CSV monolitici riscritti per intero ogni notte, ed e' cosi' che
# la history del repo e' arrivata a 6,5 GB. I CSV restano un artefatto
# derivato, rigenerato da build_site verso docs/data/.
data/gold/*.csv
!data/gold/stations_dim.csv

# bronze: ignoriamo solo csv non compressi
data/bronze/**/*.csv

# ma tracciamo sempre questi
!data/bronze/**/*.csv.gz
!data/bronze/**/*.json

# Heavy gold daily files (150–250 MB each) are never committed to git.
# They exceed GitHub LFS free bandwidth (1 GB/month) when downloaded on every
# CI run. They are rebuilt from silver in CI and uploaded directly to Pages.
data/gold/od_giorno_categoria.csv
data/gold/stazioni_giorno_categoria_ruolo.csv
data/gold/stazioni_giorno_categoria_nodo.csv
data/gold/hist_stazioni_giorno_categoria_ruolo.csv
data/gold/hist_giorno_categoria.csv

# GitHub Pages pubblica da docs
site/

# docs/data CSV files are never committed to git — they are deployed directly
# via GitHub Actions Pages artifact (upload-pages-artifact). Committing them
# would hit GitHub's 100 MB per-file limit as the dataset grows, and storing
# them in LFS breaks GitHub Pages serving (Pages only serves LFS pointer files).
docs/data/*.csv
docs/data/manifest.json
# Stessa ragione per la geometria della rete: l'originale sta in
# data/stations/, build_site ne fa una copia qui.
docs/data/*.geojson

!.gitkeep

# Cache rigenerabili delle distanze: si riscaricano, non si versionano.
# I feed GTFS sono 386 MB di zip dei gestori, la geometria dei binari 21 MB di
# risposta Overpass. Gli esiti (distanze_*.csv, km_tratte.csv) sono versionati.
data/gtfs/
data/stations/osm_binari.json
